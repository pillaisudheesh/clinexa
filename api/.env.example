# Copy to .env and provide environment-specific values.
# Generate JWT_SECRET with: openssl rand -base64 48
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/clinexa?schema=public
PORT=3000
NODE_ENV=development
JWT_SECRET=
JWT_EXPIRES_IN=1h
# Required only when running the database seed command. Use a unique password.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:3001
# Swagger is enabled by default outside production and disabled in production.
# Set SWAGGER_ENABLED=true only if production API documentation is intentionally required.
